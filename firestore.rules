rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "WEOFvjCGEwTQ52YJAuIcmOk3ZDB2";
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin(); // Allows admin to list users
    }

    match /users/{userId}/profile/{profileId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
    }

    match /users/{userId}/inbox/{messageId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); // Admin or system can create
      allow delete: if isSignedIn() && request.auth.uid == userId; // Allow user to delete their own inbox messages
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.resource.data.userProfileId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userProfileId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }

    match /chats/{chatId} {
       allow read, write: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
    }

    match /chats/{chatId}/messages/{messageId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
